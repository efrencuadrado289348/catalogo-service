@model Web.Clients.OrderRow
@{ ViewData["Title"] = "Detalle del pedido"; }

<div class="mb-4"><a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Mis pedidos</a></div>

<h1 class="h3 mb-3">Pedido <span class="small text-muted">@Model.Id</span></h1>
<p>
    <strong>Fecha (UTC):</strong> @Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")<br />
    <strong>Estado:</strong> <span class="badge text-bg-secondary">@Model.StatusName</span>
</p>

<table class="table align-middle">
    <thead><tr><th>Producto</th><th class="text-end">Cantidad</th><th class="text-end">Precio unitario</th><th class="text-end">Subtotal</th></tr></thead>
    <tbody>
    @foreach (var i in Model.Items)
    {
        <tr>
            <td>@i.ProductName</td>
            <td class="text-end">@i.Quantity</td>
            <td class="text-end">@i.UnitPrice.ToString("N0")</td>
            <td class="text-end">@i.Subtotal.ToString("N0")</td>
        </tr>
    }
    </tbody>
    <tfoot><tr><th colspan="3" class="text-end">Total</th><th class="text-end">@Model.Total.ToString("N0")</th></tr></tfoot>
</table>
