@model IReadOnlyList<Web.Clients.OrderRow>
@{ ViewData["Title"] = "Mis pedidos"; }

<h1 class="h3 mb-4">Mis pedidos</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Aún no tienes pedidos.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead><tr><th>Fecha (UTC)</th><th>Pedido</th><th>Estado</th><th class="text-end">Total</th><th></th></tr></thead>
        <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                <td class="small text-muted">@o.Id</td>
                <td><span class="badge text-bg-secondary">@o.StatusName</span></td>
                <td class="text-end">@o.Total.ToString("N0")</td>
                <td class="text-end"><a asp-action="Details" asp-route-id="@o.Id" class="btn btn-outline-dark btn-sm">Ver detalle</a></td>
            </tr>
        }
        </tbody>
    </table>
}
