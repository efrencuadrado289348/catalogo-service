@model IReadOnlyList<Web.Clients.OrderRow>
@{
    ViewData["Title"] = "Gestión de pedidos";
    string selectedStatus = ViewBag.SelectedStatus as string ?? string.Empty;
    var filterOptions = new (string Value, string Label)[]
    {
        ("", "Todos"),
        ("Pending", "Pendientes"),
        ("Confirmed", "Confirmados"),
        ("Shipped", "Enviados"),
        ("Cancelled", "Cancelados")
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Gestión de pedidos</h1>
        <p class="text-muted mb-0">Flujo de estados: Pendiente → Confirmado → Enviado / Cancelado.</p>
    </div>

    <div class="btn-group" role="group" aria-label="Filtrar pedidos por estado">
        @foreach (var option in filterOptions)
        {
            var active = string.Equals(selectedStatus, option.Value, StringComparison.OrdinalIgnoreCase);
            <a asp-action="Index"
               asp-route-status="@(string.IsNullOrEmpty(option.Value) ? null : option.Value)"
               class="btn btn-sm @(active ? "btn-dark" : "btn-outline-dark")">
                @option.Label
            </a>
        }
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay pedidos para el filtro seleccionado.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Fecha (UTC)</th>
                    <th>Pedido</th>
                    <th>Cliente</th>
                    <th>Productos</th>
                    <th>Estado</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var o in Model)
            {
                var returnUrl = Context.Request.Path + Context.Request.QueryString;
                <tr>
                    <td>@o.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="small text-muted"><code>@o.Id</code></td>
                    <td class="small text-muted"><code>@o.CustomerId</code></td>
                    <td>@o.Items.Sum(i => i.Quantity) u. (@o.Items.Count línea(s))</td>
                    <td><span class="badge @o.StatusBadgeClass">@o.StatusName</span></td>
                    <td class="text-end">@o.Total.ToString("N0")</td>
                    <td class="text-end">
                        <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                            @if (o.Status == 1)
                            {
                                <form asp-action="ChangeStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@o.Id" />
                                    <input type="hidden" name="status" value="Confirmed" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-success btn-sm">Confirmar</button>
                                </form>
                                <form asp-action="ChangeStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@o.Id" />
                                    <input type="hidden" name="status" value="Cancelled" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Cancelar</button>
                                </form>
                            }
                            else if (o.Status == 2)
                            {
                                <form asp-action="ChangeStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@o.Id" />
                                    <input type="hidden" name="status" value="Shipped" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-primary btn-sm">Enviar</button>
                                </form>
                                <form asp-action="ChangeStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@o.Id" />
                                    <input type="hidden" name="status" value="Cancelled" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Cancelar</button>
                                </form>
                            }
                            <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-outline-dark btn-sm">Ver detalle</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
