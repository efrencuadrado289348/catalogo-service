@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="h3 text-danger">Ocurrió un error</h1>
<p>No fue posible procesar la solicitud. Intenta de nuevo.</p>
@if (!string.IsNullOrEmpty(Model.RequestId))
{
    <p class="text-muted small">Id de la solicitud: <code>@Model.RequestId</code></p>
}
