<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-commerce Electrónicos</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">E-commerce Electrónicos</a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @* Each link belongs to a feature: see docs/frontend-web.md *@
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Productos</a></li>

                        @if (User.IsInRole(Roles.Cliente))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Cart" asp-action="Index">Mi carrito</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Orders" asp-action="Index">Mis pedidos</a></li>
                        }

                        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Vendedor))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="CatalogAdmin" asp-action="Index">Gestión del catálogo</a></li>
                        }

                        @if (User.IsInRole(Roles.Vendedor))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="SalesOrders" asp-action="Index">Gestión de pedidos</a></li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 text-light">
                        <span>@User.Identity?.Name</span>
                        @foreach (var role in User.FindAll(ClaimTypes.Role))
                        {
                            <span class="badge text-bg-info">@role.Value</span>
                        }
                        <form asp-controller="Account" asp-action="Logout" method="post" class="ms-2">
                            <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </nav>

    <main class="container flex-grow-1 pb-4">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="border-top py-3 text-muted small">
        <div class="container">Programación Distribuida · Grupo 2 · Identity + Catalog + Pedidos</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
