@model Web.Models.CreateProductViewModel
@{ ViewData["Title"] = "Nuevo producto"; }

<h1 class="h3">Nuevo producto</h1>

<form asp-action="CreateProduct" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3"><label asp-for="Name" class="form-label">Nombre</label>
        <input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Description" class="form-label">Descripción</label>
        <input asp-for="Description" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Price" class="form-label">Precio</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Currency" class="form-label">Moneda</label>
        <input asp-for="Currency" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Stock" class="form-label">Stock</label>
        <input asp-for="Stock" type="number" class="form-control" /></div>
    <div class="mb-3"><label asp-for="CategoryId" class="form-label">Categoría</label>
        <select asp-for="CategoryId" class="form-select"
                asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
            <option value="">Selecciona...</option>
        </select></div>

    <button class="btn btn-primary">Crear</button>
    <a class="btn btn-link" asp-action="Index">Cancelar</a>
</form>
