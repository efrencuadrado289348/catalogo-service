@model List<Web.Cart.CartLine>
@{
    ViewData["Title"] = "Mi carrito";
    var total = Model.Sum(l => l.Subtotal);
    var currency = Model.FirstOrDefault()?.Currency ?? "";
}

<h1 class="h3 mb-4">Mi carrito</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Tu carrito está vacío.</div>
    <a asp-controller="Products" asp-action="Index" class="btn btn-dark">Ver catálogo</a>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr><th>Producto</th><th class="text-end">Precio</th><th style="width:180px">Cantidad</th><th class="text-end">Subtotal</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var line in Model)
        {
            <tr>
                <td>@line.Name</td>
                <td class="text-end">@line.UnitPrice.ToString("N0") @line.Currency</td>
                <td>
                    <form asp-action="Update" method="post" class="d-flex gap-2">
                        <input type="hidden" name="productId" value="@line.ProductId" />
                        <input type="number" name="quantity" value="@line.Quantity" min="0" max="@line.Stock" class="form-control form-control-sm" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Actualizar</button>
                    </form>
                </td>
                <td class="text-end">@line.Subtotal.ToString("N0") @line.Currency</td>
                <td class="text-end">
                    <form asp-action="Remove" method="post">
                        <input type="hidden" name="productId" value="@line.ProductId" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">Quitar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total</th>
                <th class="text-end">@total.ToString("N0") @currency</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <div class="d-flex gap-2">
        <form asp-action="Checkout" method="post">
            <button type="submit" class="btn btn-primary">Realizar pedido</button>
        </form>
        <form asp-action="Clear" method="post">
            <button type="submit" class="btn btn-outline-secondary">Vaciar carrito</button>
        </form>
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-dark">Seguir comprando</a>
    </div>
}
